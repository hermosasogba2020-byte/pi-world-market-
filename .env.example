# ============================================================
# Pi World Market — configuration
# Copiez ce fichier en ".env" et remplissez vos propres valeurs.
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=3000
APP_ID=pi-world-market

# Secret utilisé pour signer les cookies de session (JWT).
# Générez une longue chaîne aléatoire, ex: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# openId du compte qui doit automatiquement devenir admin (optionnel).
# Laissez vide, puis mettez à jour le rôle en base après votre 1ère inscription.
OWNER_OPEN_ID=

# --- Base de données MySQL ---
# Exemple Railway/PlanetScale: mysql://user:password@host:3306/dbname
# Exemple TiDB Cloud Serverless: mysql://user:password@gateway01.xxx.tidbcloud.com:4000/dbname
DATABASE_URL=mysql://user:password@localhost:3306/pi_world_market
# Laissez à "true" pour toute base hébergée (TiDB, PlanetScale, Railway public...).
# Mettez "false" uniquement pour une base MySQL locale sans TLS.
DB_SSL=true

# --- IA (chat, recommandations) — compatible OpenAI ---
# Créez une clé sur https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Stockage de fichiers (S3 ou compatible: AWS S3, Cloudflare R2, Backblaze B2, MinIO) ---
S3_BUCKET=
S3_REGION=auto
# Laissez S3_ENDPOINT vide pour AWS S3 direct. Pour R2/MinIO, mettez l'URL du endpoint.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optionnel: URL publique/CDN si votre bucket est public (évite les URLs signées)
S3_PUBLIC_BASE_URL=

# --- Google Maps (géolocalisation, itinéraires) ---
GOOGLE_MAPS_API_KEY=

# --- Notifications admin (optionnel) ---
# URL d'un webhook (Slack, Discord, etc.) qui recevra un POST { title, content }
NOTIFY_WEBHOOK_URL=
